# Rendered file — see the blueprint's conditional_files entry for its destination.
# Interpolates: project_name, python_version.

# syntax=docker/dockerfile:1

FROM python:{{ python_version }}-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Copy only what the build needs first, so layer caching survives
# source-only changes.
COPY pyproject.toml README.md ./
COPY src ./src

RUN pip install --no-cache-dir .

EXPOSE 8000

CMD ["uvicorn", "{{ project_name | replace('-', '_') }}.main:app", "--host", "0.0.0.0", "--port", "8000"]
